APP_PORT=7200
VITE_UPDATES_URL=/updates.json
VITE_REPO_URL=https://github.com/USER/REPO
VITE_REPO_API_URL=https://api.github.com/repos/USER/REPO
VITE_CONTACT_EMAIL=hello@example.com
# Raw markdown URLs for the in-app legal modal (imprint + privacy).
VITE_LEGAL_NOTICE_URL=https://raw.githubusercontent.com/USER/META-REPO/main/imprint.md
VITE_PRIVACY_URL=https://raw.githubusercontent.com/USER/META-REPO/main/privacy.md
# Raw markdown URL for the mobile app's privacy policy, built as /privacy-app.
VITE_PRIVACY_APP_URL=https://raw.githubusercontent.com/USER/META-REPO/main/privacy_app.md
VITE_DEVELOPER_NAME=Your Name
VITE_DEVELOPER_PROFILE_URL=https://example.com/@your-profile

# Social media links (shown in the "Help Us Grow" panel section)
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/YOUR_PAGE
VITE_SOCIAL_INSTAGRAM=https://instagram.com/YOUR_HANDLE
VITE_SOCIAL_REDDIT=https://reddit.com/r/YOUR_SUBREDDIT
VITE_SOCIAL_THREADS=https://threads.net/@YOUR_HANDLE
VITE_SOCIAL_TELEGRAM=https://t.me/YOUR_CHANNEL
VITE_KOFI_URL=https://ko-fi.com/YOUR_HANDLE
# Donate button targets (JSON array). One link → the button opens it directly;
# several → a list window. Overrides VITE_KOFI_URL when set.
# VITE_DONATION_LINKS=[{"name":"Terraink","url":"https://ko-fi.com/YOUR_HANDLE"},{"name":"OpenStreetMap","url":"https://supporting.openstreetmap.org/donate/"}]
# Coffee menu links — the donate button opens this list. One entry per drink:
# VITE_DONATION_LINKS=[{"name":"Buy me a coffee","url":"https://buymeacoffee.com/YOUR_HANDLE"}]

# One-time lead capture before the first download: POSTs {name, phone, email}
# to this endpoint once per visitor. Point it at your server, a serverless
# function, or a form service (e.g. formspree). Empty = form still shows,
# data stays local.
VITE_LEAD_ENDPOINT=

# Personal payment gateway for the coffee shop (buy-me-a-coffee menu).
# The app POSTs { item, amount, currency:"IRT", name, phone, email, page }
# and expects JSON: { "ok": true, "paymentUrl": "https://…", "sandbox": false }.
# Sandbox credentials/endpoint go here once provisioned — leave empty to show
# the "gateway pending" notice instead of a fake checkout.
VITE_PAYMENT_GATEWAY_URL=
VITE_PAYMENT_GATEWAY_TOKEN=

# Zibal (زیبال) merchant id — preferred personal gateway for the coffee shop.
# Request/verify use only this id; no secret is exposed to the browser.
# Flow: request → gateway.zibal.ir/start/{trackId} → callback ?chinar_pay=1
# → verify. Sandbox merchant id goes here once provisioned.
VITE_ZIBAL_MERCHANT=

# Google Search Console verification token
VITE_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google AdSense publisher ID for ads.txt — BARE form (e.g. pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_PUBLISHER_ID=

# Google AdSense client ID for the loader script and ad units — ca-pub form
VITE_ADSENSE_AD_CLIENT=

# Sidebar ad unit in the poster preview panel. The slot is OFF unless enabled.
VITE_ADS_SIDEBAR_ENABLED=false
VITE_AD_SLOT_SIDEBAR=

# Canvas credits URL (shown bottom-left on the poster when Show Credits is enabled)
VITE_APP_CREDIT_URL=terraink.app

# Public site origin used in index.html meta tags (no trailing slash)
VITE_SITE_URL=https://example.com

# ── Telegram delivery (server-side relay: server/telegram-bot.mjs) ──
# Bot token from @BotFather — server env ONLY, never VITE_*.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# Optional fixed chat id; auto-resolves from getUpdates when unset.
# TELEGRAM_CHAT_ID=
# Public URL of the relay's /api/send endpoint — enables "Send to Telegram".
VITE_TELEGRAM_ENDPOINT=
